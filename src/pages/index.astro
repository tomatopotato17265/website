---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import AboutContent from '../components/AboutContent.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const blogPosts = await getCollection('blog');
const renderedPosts = await Promise.all(
	blogPosts.map(async (post) => {
		const { Content } = await render(post);
		return { id: post.id, data: post.data, Content };
	}),
);

const aboutEntry = {
	id: 'about',
	data: {
		title: 'About Me',
		pubDate: new Date('August 08 2021'),
		heroImage: AboutHeroImage,
	},
	Content: null,
};

const entries = [...renderedPosts, aboutEntry].sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 3em 1em;
			}
			.intro {
				margin-bottom: 2em;
			}
			.entry {
				margin: 3em 0;
			}
			.entry .hero-image img {
				display: block;
				margin: 0 auto 1em auto;
				width: 100%;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.entry .date {
				margin-bottom: 0.3em;
				color: rgb(var(--gray));
			}
			.entry h2 {
				margin-top: 0;
			}
			.spectrum-divider {
				margin: 3em 0;
			}
			.wave {
				display: inline-block;
				line-height: 1;
				margin-right: 0.15em;
				transform-origin: 70% 84%;
				animation: wave 1.4s ease-in-out infinite;
			}
			@keyframes wave {
				0%,
				100% {
					transform: rotate(-20deg);
				}
				50% {
					transform: rotate(20deg);
				}
			}
		</style>
	</head>
	<body>
		<main>
			<section class="intro">
				<h1><span class="wave">👋</span> Hey, I'm Nimai!</h1>
				<p>And here's my page :)</p>
			</section>
			<hr class="spectrum-divider" />
			{
				entries.map((entry) => (
					<>
						<article class="entry">
							<div class="hero-image">
								{entry.data.heroImage && (
									<Image width={1020} height={510} src={entry.data.heroImage} alt="" />
								)}
							</div>
							<p class="date">
								<FormattedDate date={entry.data.pubDate} />
							</p>
							<h2>{entry.data.title}</h2>
							{entry.Content ? <entry.Content /> : <AboutContent />}
						</article>
						<hr class="spectrum-divider" />
					</>
				))
			}
		</main>
		<Footer />
	</body>
</html>
