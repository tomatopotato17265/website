---
import curseforgeIcon from '../assets/curseforge.svg';
import discordIcon from '../assets/discord.svg';
import githubIcon from '../assets/github.svg';
import mailIcon from '../assets/mail.svg';
import modrinthIcon from '../assets/modrinth.svg';

const icons = [
	{ src: modrinthIcon.src, alt: 'Modrinth', href: 'https://modrinth.com/user/tomatopotato' },
	{
		src: curseforgeIcon.src,
		alt: 'CurseForge',
		href: 'https://www.curseforge.com/members/tomatopotato/',
	},
	{ src: githubIcon.src, alt: 'GitHub', href: 'https://github.com/tomatopotato17265' },
	{ src: discordIcon.src, alt: 'Discord', href: 'https://discord.com/users/821825130506092594' },
	{ src: mailIcon.src, alt: 'Mail', href: 'mailto:contact@pencilstub.dev' },
];
---

<header class="top-bar">
	<a class="brand" href="/"></a>
	<div class="icons">
		{
			icons.map((icon) => (
				<a href={icon.href} target="_blank" rel="noopener noreferrer">
					<img src={icon.src} alt={icon.alt} width="40" height="40" />
				</a>
			))
		}
	</div>
</header>

<style>
	.top-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 1.5rem;
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		background: #fff;
		border-bottom: 1px solid rgba(17, 24, 39, 0.1);
	}

	.brand {
		font-weight: 700;
		color: #111827;
		text-decoration: none;
	}

	.icons {
		display: flex;
		align-items: center;
		gap: 1.1rem;
	}

	.icons a {
		display: block;
		line-height: 0;
	}

	.icons img {
		display: block;
		width: 30px;
		height: 30px;
		filter: brightness(0) saturate(100%);
		opacity: 0.85;
		transition: opacity 0.2s;
	}

	.icons img:hover {
		opacity: 1;
	}
</style>
