---
import Footer from '../../shared/Footer.astro';
import TopBar from '../../shared/TopBar.astro';
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SOCIAL_LINKS, SOURCE_URL } from '../consts';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<script id="discord:component-embed" type="application/json">
			{
				"component": {
					"type": 17,
					"components": [
						{
							"type": 9,
							"components": [
								{
									"type": 10,
									"content": "# Mouldy Shoe\nHi! I'm Mouldy Shoe.\n\nI'm an Australian creator who makes cinematic documentaries exploring the players, teams and moments that shape Rocket League."
								}
							],
							"accessory": {
								"type": 11,
								"media": {
									"url": "https://pencilstub.dev/mouldy_shoe/favicon.ico"
								}
							}
						},
						{
							"type": 14
						},
						{
							"type": 1,
							"components": [
								{
									"type": 2,
									"style": 5,
									"url": "https://youtube.com/@mouldy_shoe",
									"label": "Youtube"
								},
								{
									"type": 2,
									"style": 5,
									"url": "https://discord.com/invite/7rGGf95jz7",
									"label": "Discord"
								}
							]
						}
					],
					"accent_color": 1752220
				}
			}
		</script>
	</head>
	<body>
		<TopBar variant="overlay" title={SITE_TITLE} links={SOCIAL_LINKS} />
		<main>
			<slot />
			<Footer label="website" sourceUrl={SOURCE_URL} />
		</main>
	</body>
</html>
